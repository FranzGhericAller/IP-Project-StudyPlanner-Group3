# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# XAMPP default (user root, no password): mysql://root:@localhost:3306/studyplanner
# If your password has special characters, URL-encode them (e.g. @ becomes %40).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/studyplanner"

# Secret used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google login (not used yet, leave empty)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
