npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (only the example is committed)
.env*
!.env.example

# prisma client (made by "prisma generate" on npm install)
/lib/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

